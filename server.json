const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const fs = require('fs');
const path = require('path');

const app = express();
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

const PORT = process.env.PORT || 3000;
const DATA_FILE = './data.json';

/* ==================== БАЗА ==================== */
let db = {
  users: {},        // login -> user
  online: {},       // wsId -> login
  globalChat: [],
  trades: [],
  events: { x2income: 0, x3tap: 0, x2luck: 0, casediscount: 0 },
  firstAccountCreated: false,
};

function loadDb() {
  try {
    if (fs.existsSync(DATA_FILE)) {
      const raw = JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
      db = { ...db, ...raw };
      console.log('DB loaded. Users:', Object.keys(db.users).length);
    }
  } catch (e) { console.log('DB load error:', e.message); }
}

function saveDb() {
  try {
    fs.writeFileSync(DATA_FILE, JSON.stringify(db, null, 2));
  } catch (e) { console.log('DB save error:', e.message); }
}

loadDb();

/* ==================== EXPRESS ==================== */
app.use(express.json({ limit: '5mb' }));
app.use(express.static('public'));

app.get('/health', (req, res) => res.send('OK'));

app.post('/api/register', (req, res) => {
  const { login, pass, name, email, username } = req.body;
  if (!login || !pass) return res.json({ ok: false, error: 'Нет логина/пароля' });
  if (login.length < 3 || login.length > 20) return res.json({ ok: false, error: 'Логин 3-20 символов' });
  if (db.users[login]) return res.json({ ok: false, error: 'Логин занят' });

  const isFirst = !db.firstAccountCreated;

  db.users[login] = {
    login,
    pass,
    name: name || login,
    username: username || login.toLowerCase(),
    email: email || '',
    id: Math.floor(Math.random() * 90000) + 10000,
    level: 1,
    xp: 0,
    balance: isFirst ? 500000 : 1000,
    diamonds: isFirst ? 10000 : 0,
    totalEarned: 0,
    taps: 0,
    pets: [],
    activePet: null,
    casesOpened: 0,
    createdAt: Date.now(),
    premiumUntil: isFirst ? Date.now() + 365 * 86400000 : 0,
    settings: { theme: 'dark', accent: 'gold' },
    priv: isFirst ? ['creator', 'verified'] : ['player'],
    bio: isFirst ? 'Основатель REMOL' : '',
    isBanned: false,
    banReason: '',
    banUntil: 0,
    banBy: '',
    avatar: null,
    clicks: {},
    world: 'city',
    worlds: ['city'],
  };

  if (isFirst) db.firstAccountCreated = true;
  saveDb();

  res.json({ ok: true, user: db.users[login], isFirst });
});

app.post('/api/login', (req, res) => {
  const { login, pass } = req.body;
  const user = db.users[login];
  if (!user) return res.json({ ok: false, error: 'Игрок не найден' });
  if (user.pass !== pass) return res.json({ ok: false, error: 'Неверный пароль' });
  if (user.isBanned && (!user.banUntil || user.banUntil > Date.now())) {
    return res.json({ ok: false, banned: true, user });
  }
  res.json({ ok: true, user });
});

app.post('/api/save', (req, res) => {
  const { login, state } = req.body;
  if (!login || !db.users[login]) return res.json({ ok: false });
  const protected_keys = ['pass', 'login', 'priv', 'isBanned'];
  const safe = {};
  for (const k of Object.keys(state)) {
    if (!protected_keys.includes(k)) safe[k] = state[k];
  }
  db.users[login] = { ...db.users[login], ...safe };
  saveDb();
  res.json({ ok: true });
});

app.get('/api/players', (req, res) => {
  const list = Object.values(db.users).map(u => ({
    login: u.login, name: u.name, username: u.username, level: u.level,
    balance: u.balance, diamonds: u.diamonds, taps: u.taps, totalEarned: u.totalEarned,
    priv: u.priv, avatar: u.avatar, pets: u.pets, isBanned: u.isBanned,
    online: Object.values(db.online).includes(u.login),
  }));
  res.json({ ok: true, players: list });
});

app.get('/api/events', (req, res) => res.json({ ok: true, events: db.events }));

/* ==================== WEBSOCKET ==================== */
let wsIdCounter = 0;
const clients = new Map(); // wsId -> ws

function broadcast(data) {
  const msg = JSON.stringify(data);
  wss.clients.forEach(c => { if (c.readyState === WebSocket.OPEN) c.send(msg); });
}

function broadcastExcept(exceptId, data) {
  const msg = JSON.stringify(data);
  clients.forEach((ws, id) => {
    if (id !== exceptId && ws.readyState === WebSocket.OPEN) ws.send(msg);
  });
}

function onlineList() {
  return Object.values(db.online).map(login => db.users[login]).filter(Boolean).map(u => ({
    login: u.login, name: u.name, username: u.username, level: u.level,
    balance: u.balance, diamonds: u.diamonds, taps: u.taps, totalEarned: u.totalEarned,
    priv: u.priv, avatar: u.avatar, pets: u.pets, online: true,
  }));
}

wss.on('connection', (ws) => {
  const wsId = 'ws_' + (++wsIdCounter);
  ws.id = wsId;
  ws.login = null;
  clients.set(wsId, ws);

  ws.send(JSON.stringify({ type: 'welcome', wsId }));
  ws.send(JSON.stringify({ type: 'events', events: db.events }));

  ws.on('message', (raw) => {
    let data;
    try { data = JSON.parse(raw); } catch (e) { return; }

    switch (data.type) {
      case 'join': {
        ws.login = data.login;
        db.online[wsId] = data.login;
        ws.send(JSON.stringify({ type: 'players', players: onlineList() }));
        broadcast({ type: 'players', players: onlineList() });
        ws.send(JSON.stringify({ type: 'global_chat', messages: db.globalChat.slice(-80) }));
        break;
      }

      case 'global_chat': {
        if (!ws.login) return;
        const user = db.users[ws.login];
        if (!user) return;
        const msg = { from: user.name, login: user.login, text: String(data.text).slice(0, 300), time: Date.now() };
        db.globalChat.push(msg);
        if (db.globalChat.length > 200) db.globalChat.shift();
        broadcast({ type: 'global_chat_msg', ...msg });
        saveDb();
        break;
      }

      case 'sync': {
        if (!ws.login || !db.users[ws.login]) return;
        const u = db.users[ws.login];
        if (data.balance !== undefined) u.balance = data.balance;
        if (data.level !== undefined) u.level = data.level;
        if (data.taps !== undefined) u.taps = data.taps;
        if (data.pets !== undefined) u.pets = data.pets;
        if (data.diamonds !== undefined) u.diamonds = data.diamonds;
        broadcast({ type: 'players', players: onlineList() });
        saveDb();
        break;
      }

      // ========== АДМИН-КОМАНДЫ ==========
      case 'admin_give': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        const { target, balance, diamonds, level } = data;
        const u = db.users[target];
        if (!u) return;
        if (balance) u.balance += balance;
        if (diamonds) u.diamonds += diamonds;
        if (level) { u.level = level; u.xp = 0; }
        saveDb();
        broadcast({ type: 'players', players: onlineList() });
        broadcast({ type: 'admin_update', target, balance: u.balance, diamonds: u.diamonds, level: u.level });
        break;
      }

      case 'admin_ban': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        const { target, reason, days } = data;
        const u = db.users[target];
        if (!u) return;
        u.isBanned = true;
        u.banReason = reason || 'Нарушение правил';
        u.banBy = db.users[ws.login].name;
        u.banUntil = days > 0 ? Date.now() + days * 86400000 : 0;
        saveDb();
        for (const [id, login] of Object.entries(db.online)) {
          if (login === target) {
            const t = clients.get(id);
            if (t) t.send(JSON.stringify({ type: 'you_banned', reason: u.banReason, until: u.banUntil, by: u.banBy }));
          }
        }
        break;
      }

      case 'admin_unban': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        const u = db.users[data.target];
        if (!u) return;
        u.isBanned = false; u.banReason = ''; u.banUntil = 0;
        saveDb();
        break;
      }

      case 'admin_give_pet': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        const u = db.users[data.target];
        if (!u) return;
        if (!u.pets.includes(data.petId)) u.pets.push(data.petId);
        saveDb();
        break;
      }

      case 'admin_event': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        const { event, minutes } = data;
        const until = Date.now() + minutes * 60000;
        db.events[event] = until;
        saveDb();
        broadcast({ type: 'events', events: db.events });
        broadcast({ type: 'admin_broadcast', from: 'ИВЕНТ', text: '🔥 ' + event + ' · ' + minutes + ' мин' });
        break;
      }

      case 'admin_broadcast': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        const from = data.from || db.users[ws.login].name;
        broadcast({ type: 'admin_broadcast', from, text: String(data.text).slice(0, 300) });
        break;
      }

      case 'admin_delete': {
        if (!ws.login || !db.users[ws.login]?.priv?.includes('creator')) return;
        delete db.users[data.target];
        saveDb();
        broadcast({ type: 'players', players: onlineList() });
        break;
      }
    }
  });

  ws.on('close', () => {
    delete db.online[wsId];
    clients.delete(wsId);
    broadcast({ type: 'players', players: onlineList() });
  });
});

/* ==================== СТАРТ ==================== */
server.listen(PORT, '0.0.0.0', () => {
  console.log('REMOL server started on port ' + PORT);
});
